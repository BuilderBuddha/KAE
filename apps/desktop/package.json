{
  "name": "@scooper/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "KAE desktop application",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:packages --prefix ../.. && vite",
    "build": "tsc -p tsconfig.node.json && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@scooper/capability-engine": "*",
    "@scooper/connector-engine": "*",
    "@scooper/core": "*",
    "@scooper/exporters": "*",
    "@scooper/graph": "*",
    "@scooper/importers": "*",
    "@scooper/parser": "*",
    "@scooper/repository-engine": "*",
    "@scooper/source-engine": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
